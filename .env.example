###############################################################
#### Backends                                              ####
###############################################################

# Walnut backend serving simulations, traces, verification and search.
# Defaults to the public instance when unset; point it at your own if you run
# walnut-server locally (http://localhost:3000).
# NEXT_PUBLIC_API_URL=https://api.walnut.dev

###############################################################
#### Optional                                              ####
###############################################################

# Browser log verbosity: trace | debug | info | warn | error | silent
# NEXT_PUBLIC_LOG_LEVEL=info

# Client-side tracking (session replay). Off by default.
# To turn it off in a single browser, set the cookie skip_tracking_pls=true.
NEXT_PUBLIC_USE_TRACKING=false
