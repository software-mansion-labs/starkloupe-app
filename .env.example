###############################################################
#### Required to boot the app                              ####
###############################################################

# Postgres connection string. Production uses Neon; locally a free Neon dev
# branch is the least trouble, since the app talks to the database over Neon's
# HTTP driver. Run `npm run db:push` once to create the schema.
DATABASE_URL=

# Session signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of this app. Must match the port the dev server runs on and the
# callback URL registered in your GitHub OAuth app.
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth app credentials, from github.com/settings/developers.
# Homepage URL:  http://localhost:5173
# Callback URL:  http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

###############################################################
#### Backends                                              ####
###############################################################

# Walnut backend serving simulations, traces, verification and search.
# Defaults to the public instance when unset; point it at your own if you run
# walnut-server locally (http://localhost:3000).
# NEXT_PUBLIC_API_URL=https://api.walnut.dev

# Walnut main server, used for organizations, members and monitoring.
# Only needed if you turn on the monitoring feature below.
# WALNUT_MAIN_API_URL=http://localhost:4000/main/v1

###############################################################
#### Feature flags                                         ####
###############################################################

# Show the monitoring section. Requires WALNUT_MAIN_API_URL.
NEXT_PUBLIC_MONITORING_FEATURE=false

# Require a signed-in user on protected routes.
NEXT_PUBLIC_REQUIRE_AUTHORIZATION_FEATURE=true

# Client-side tracking (session replay). Off by default.
# To turn it off in a single browser, set the cookie skip_tracking_pls=true.
NEXT_PUBLIC_USE_TRACKING=false

###############################################################
#### Optional                                              ####
###############################################################

# Base URL used by the auth client in the browser. Only needed when the app is
# served from a different origin than BETTER_AUTH_URL.
# NEXT_PUBLIC_APP_URL=http://localhost:5173

# Browser log verbosity: trace | debug | info | warn | error | silent
# NEXT_PUBLIC_LOG_LEVEL=info

###############################################################
#### Preview environments only — never set in production    ####
###############################################################
#
# When either of these is set, the router middleware lets every request
# through without a session, and backend calls go out with a fixed test header
# instead of a bearer token. This exists so Cloudflare preview deployments can
# be browsed without signing in. Setting it in production turns off
# authentication completely.
#
# TEST_USER=Testuser
# NEXT_PUBLIC_TEST_USER=Testuser
